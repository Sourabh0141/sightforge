{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "defaults.schema.json",
  "title": "SightForgeDefaultsConfig",
  "description": "Unified operational defaults and plan constraints per R78",
  "type": "object",
  "required": [
    "auth",
    "media",
    "video",
    "retention",
    "quotas",
    "models",
    "freePlanCeilings"
  ],
  "properties": {
    "auth": {
      "type": "object",
      "required": ["accessTokenTtlSeconds", "refreshTokenTtlDays", "argon2id"],
      "properties": {
        "accessTokenTtlSeconds": { "type": "integer", "minimum": 60 },
        "refreshTokenTtlDays": { "type": "integer", "minimum": 1 },
        "argon2id": {
          "type": "object",
          "required": ["memoryKiB", "iterations", "parallelism", "version"],
          "properties": {
            "memoryKiB": { "type": "integer", "minimum": 1024 },
            "iterations": { "type": "integer", "minimum": 1 },
            "parallelism": { "type": "integer", "minimum": 1 },
            "version": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": [
        "maxImageSizeBytes",
        "maxVideoSizeBytes",
        "maxVideoDurationSeconds",
        "maxImageDimensionPixels",
        "maxImageTotalPixels",
        "allowedImageMimeTypes",
        "allowedVideoMimeTypes"
      ],
      "properties": {
        "maxImageSizeBytes": { "type": "integer", "minimum": 1024 },
        "maxVideoSizeBytes": { "type": "integer", "minimum": 1024 },
        "maxVideoDurationSeconds": { "type": "integer", "minimum": 1 },
        "maxImageDimensionPixels": { "type": "integer", "minimum": 1 },
        "maxImageTotalPixels": { "type": "integer", "minimum": 1 },
        "allowedImageMimeTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedVideoMimeTypes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "required": [
        "defaultPerFrameSamplingFps",
        "minPerFrameSamplingFps",
        "maxPerFrameSamplingFps",
        "maxTrackingFps"
      ],
      "properties": {
        "defaultPerFrameSamplingFps": { "type": "number", "minimum": 1 },
        "minPerFrameSamplingFps": { "type": "number", "minimum": 1 },
        "maxPerFrameSamplingFps": { "type": "number", "minimum": 1 },
        "maxTrackingFps": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": [
        "completedInputMediaDays",
        "failedInputMediaDays",
        "completedResultsDays",
        "multipartUploadExpiryDays"
      ],
      "properties": {
        "completedInputMediaDays": { "type": "integer", "minimum": 1 },
        "failedInputMediaDays": { "type": "integer", "minimum": 1 },
        "completedResultsDays": { "type": "integer", "minimum": 1 },
        "multipartUploadExpiryDays": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "quotas": {
      "type": "object",
      "required": [
        "defaultUserDailyJobsQuota",
        "authLockoutMaxAttempts",
        "authLockoutWindowSeconds",
        "monthlySpendWarningUsd",
        "monthlySpendCriticalUsd"
      ],
      "properties": {
        "defaultUserDailyJobsQuota": { "type": "integer", "minimum": 1 },
        "authLockoutMaxAttempts": { "type": "integer", "minimum": 1 },
        "authLockoutWindowSeconds": { "type": "integer", "minimum": 60 },
        "monthlySpendWarningUsd": { "type": "number", "minimum": 0 },
        "monthlySpendCriticalUsd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "required": [
        "defaultVariant",
        "availableVariants",
        "defaultVariantPerTask",
        "coldStartBudgetSeconds"
      ],
      "properties": {
        "defaultVariant": { "type": "string" },
        "availableVariants": {
          "type": "array",
          "items": { "type": "string" }
        },
        "defaultVariantPerTask": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "coldStartBudgetSeconds": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "freePlanCeilings": {
      "type": "object",
      "required": [
        "workerCpuPerInvocationMs",
        "workerRequestsPerDay",
        "subrequestsPerInvocation",
        "cronTriggers",
        "maxScriptGzipBytes",
        "d1ReadsPerDay",
        "d1WritesPerDay",
        "d1StorageBytes",
        "queueOperationsPerDay",
        "r2StorageBytes",
        "durableObjectRequestsPerDay",
        "durableObjectDurationGbSecondsPerDay"
      ],
      "properties": {
        "workerCpuPerInvocationMs": { "type": "integer", "minimum": 1 },
        "workerRequestsPerDay": { "type": "integer", "minimum": 1 },
        "subrequestsPerInvocation": { "type": "integer", "minimum": 1 },
        "cronTriggers": { "type": "integer", "minimum": 1 },
        "maxScriptGzipBytes": { "type": "integer", "minimum": 1 },
        "d1ReadsPerDay": { "type": "integer", "minimum": 1 },
        "d1WritesPerDay": { "type": "integer", "minimum": 1 },
        "d1StorageBytes": { "type": "integer", "minimum": 1 },
        "queueOperationsPerDay": { "type": "integer", "minimum": 1 },
        "r2StorageBytes": { "type": "integer", "minimum": 1 },
        "durableObjectRequestsPerDay": { "type": "integer", "minimum": 1 },
        "durableObjectDurationGbSecondsPerDay": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
