{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sightforge-scheduler-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sightforge-d1-prod",
      "database_id": "696419b2-29b0-42f8-8ed6-9737a1874bc9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sightforge-media-prod"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "0 0 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_ROOM",
        "class_name": "JobRoom",
        "script_name": "sightforge-api-jobs-prod"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "prod"
  }
}